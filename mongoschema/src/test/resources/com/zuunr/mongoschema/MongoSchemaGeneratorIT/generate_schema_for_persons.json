{
  "meta": {
    "validationStrategy": "EXACT_MATCHING"
  },
  "tests": [
    {
      "given": [
        {
          "drop": {
            "collection": "persons"
          }
        },
        {
          "insert": {
            "collection": "persons",
            "documents": [
              {
                "_id": "alice-1",
                "name": "Alice",
                "age": 30
              },
              {
                "_id": "bob-1",
                "name": "Bob",
                "age": 25
              }
            ]
          }
        }
      ]
    },
    {
      "when": {
        "collection": "persons"
      }
    },
    {
      "then": {
        "properties": {
          "age": {
            "maximum": 30,
            "minimum": 25,
            "type": "integer"
          },
          "name": {
            "minLength": 3,
            "maxLength": 5,
            "type": "string"
          },
          "_id": {
            "minLength": 5,
            "maxLength": 7,
            "type": "string"
          }
        },
        "required": [
          "_id",
          "age",
          "name"
        ],
        "type": "object",
        "additionalProperties": false
      }
    }
  ]
}