{
  "sequence": [
    { "given": {} },
    {
      "description": "Poll until attempts reaches 3 - checked by two different 'then' blocks in the same retry group",
      "retry": { "intervalMillis": 5, "timeoutMillis": 2000 },
      "steps": [
        { "when": {} },
        { "then": { "attempts": 3 } },
        {
          "meta": { "validationStrategy": "ALLOWING_EXTRA_PROPERTIES" },
          "then": { "attempts": { "$schema": { "minimum": 3 } } }
        }
      ]
    }
  ]
}
