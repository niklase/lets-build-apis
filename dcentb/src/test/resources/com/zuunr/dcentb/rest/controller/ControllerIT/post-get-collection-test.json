{
  "tests": [
    {
      "given": {
        "dbSetup": {
          "connection": "mongodb://admin:adminpassword@localhost:27017/?authSource=admin",
          "db": "dcentb-mytest",
          "commands": [
            {
              "drop": {
                "collection": "players"
              }
            },
            {
              "insert": {
                "collection": "players",
                "documents": [
                  {
                    "_id": {
                      "ObjectId": "69ce3b99db652b46a90cb4bd"
                    },
                    "name": "Peter",
                    "age": 30,
                    "contacts": {
                      "email": "peter@example.com"
                    }
                  },
                  {
                    "_id": {
                      "ObjectId": "69ce48e1db652b46a90cb4c4"
                    },
                    "name": "Zeus",
                    "age": 50,
                    "contacts": {
                      "email": "zeus@example.com"
                    }
                  },
                  {
                    "_id": {
                      "ObjectId": "69ce48e1db652b46a90cb4c5"
                    },
                    "name": "Anna",
                    "age": 25,
                    "contacts": {
                      "email": "anna@example.com"
                    }
                  }
                ]
              }
            }
          ]
        },
        "config": {
          "openapi": "3.1.0",
          "accessControl": {
            "userInfo": {}
          },
          "paths": {
            "/players/getCollection": {
              "post": {
                "x-dcentb": {
                  "mongodb": {
                    "collection": "players"
                  },
                  "accessControl": {
                    "permissionSchemas": [
                      {
                        "permission": "AUTHENTICATED_DEFAULT",
                        "requestSchema": {},
                        "responseSchema": true
                      }
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "when": {
        "method": "POST",
        "uri": "/players/getCollection",
        "headers": {
          "content-type": [
            "application/json"
          ]
        },
        "body": {
          "filter": {
            "age": {
              "lt": 45,
              "gt": 20
            }
          },
          "limit": 10,
          "offset": 0
        }
      }
    },
    {
      "then": {
        "body": {
          "items": [
            {
              "contacts": {
                "email": "peter@example.com"
              },
              "age": 30,
              "name": "Peter",
              "meta": {
                "id": "69ce3b99db652b46a90cb4bd"
              }
            },
            {
              "contacts": {
                "email": "anna@example.com"
              },
              "age": 25,
              "name": "Anna",
              "meta": {
                "id": "69ce48e1db652b46a90cb4c5"
              }
            }
          ]
        },
        "status": 200
      }
    }
  ]
}