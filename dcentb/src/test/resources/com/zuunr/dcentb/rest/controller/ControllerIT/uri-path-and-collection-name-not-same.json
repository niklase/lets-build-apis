    },
    {
      "when": {
        "method": "GET",
        "uri": "/players?limit=1",
        "headers": {
          "api-key": [
            "RANDOMUUID_user1234_PERMISSION-A"
          ],
          "priority": [
            "u=0, i"
          ],
          "sec-fetch-site": [
