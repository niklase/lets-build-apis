{
  "meta": {
    "validationStrategy": "ALLOWING_EXTRA_PROPERTIES",
    "variables": {
      "##var1##": "students"
    }
  },
  "tests": [
    {
      "given": {
        "dbSetup": {
          "connection": "mongodb://admin:adminpassword@localhost:27017/?authSource=admin",
          "db": "dcentb-demo",
          "commands": [
            {
              "drop": {
                "collection": "students"
              }
            },
            {
              "drop": {
                "collection": "api-keys"
              }
            },
            {
              "insert": {
                "collection": "api-keys",
                "documents": [
                  {
                    "_id": "teacher-a-apikey",
                    "userId": "teacher-A",
                    "teacherId": "teacher-A",
                    "permissions": [
                      "teacher"
                    ]
                  },
                  {
                    "_id": "teacher-b-apikey",
                    "userId": "teacher-B",
                    "teacherId": "teacher-B",
                    "permissions": [
                      "teacher"
                    ]
                  },
                  {
                    "_id": "student-anna-apikey",
                    "userId": "student-anna",
                    "studentId": "student-anna",
                    "permissions": [
                      "student"
                    ]
                  },
                  {
                    "_id": "student-peter-apikey",
                    "userId": "student-peter",
                    "studentId": "student-peter",
                    "permissions": [
                      "student"
                    ]
                  },
                  {
                    "_id": "student-robert-apikey",
                    "userId": "student-robert",
                    "studentId": "student-robert",
                    "permissions": [
                      "student"
                    ]
                  },
                  {
                    "_id": "admin-a1-apikey",
                    "userId": "admin-a1",
                    "permissions": [
                      "admin"
                    ]
                  }
                ]
              }
            }
          ]
        },
        "config": "demo.openapi.json"
      }
    },
    {
      "description": "Create a new student Anna",
      "when": {
        "method": "POST",
        "uri": "/students",
        "headers": {
          "content-type": [
            "application/json"
          ],
          "api-key": [
            "admin-a1-apikey"
          ]
        },
        "body": {
          "name": "Anna",
          "email": "anna@example.com",
          "studentId": "student-anna",
          "teacherId": "teacher-A",
          "grade": "C",
          "attendancePercent": 100
        }
      }
    },
    {
      "then": {
        "body": {
          "name": "Anna",
          "meta": {}
        },
        "status": 201,
        "headers": {}
      },
      "meta": {
        "setVariables": {
          "{{student-anna-href}}": "/headers/location/0"
        }
      }
    },
    {
      "description": "Create a new student Peter",
      "when": {
        "method": "POST",
        "uri": "/students",
        "headers": {
          "content-type": [
            "application/json"
          ],
          "api-key": [
            "admin-a1-apikey"
          ]
        },
        "body": {
          "name": "Peter",
          "email": "peter@example.com",
          "studentId": "student-peter",
          "teacherId": "teacher-A",
          "grade": "D",
          "attendancePercent": 92
        }
      }
    },
    {
      "then": {
        "body": {
          "name": "Peter",
          "meta": {}
        },
        "status": 201,
        "headers": {}
      },
      "meta": {
        "setVariables": {
          "{{student-peter-href}}": "/headers/location/0"
        }
      }
    },
    {
      "description": "Create a new student Robert",
      "when": {
        "method": "POST",
        "uri": "/students",
        "headers": {
          "content-type": [
            "application/json"
          ],
          "api-key": [
            "admin-a1-apikey"
          ]
        },
        "body": {
          "name": "Robert",
          "email": "robert@example.com",
          "studentId": "student-robert",
          "teacherId": "teacher-A",
          "grade": "A",
          "attendancePercent": 98
        }
      }
    },
    {
      "then": {
        "body": {
          "name": "Robert",
          "meta": {}
        },
        "status": 201,
        "headers": {}
      },
      "meta": {
        "setVariables": {
          "{{student-robert-href}}": "/headers/location/0"
        }
      }
    },
    {
      "description": "As teacher-A, try to get all students of any teacher",
      "when": {
        "method": "GET",
        "uri": "/students",
        "headers": {
          "accept": [
            "application/json"
          ],
          "api-key": [
            "teacher-a-apikey"
          ]
        }
      }
    },
    {
      "then": {
        "body": {},
        "status": 403,
        "headers": {}
      },
      "meta": {
        "setVariables": {}
      }
    },
    {
      "description": "As teacher-A, get all students of teacher-A",
      "when": {
        "method": "GET",
        "uri": "/students?filter.teacherId.eq=teacher-A",
        "headers": {
          "accept": [
            "application/json"
          ],
          "api-key": [
            "teacher-a-apikey"
          ]
        }
      }
    },
    {
      "then": {
        "body": {
          "items": [
            {
              "teacherId": "teacher-A"
            },
            {
              "teacherId": "teacher-A"
            }
          ]
        },
        "status": 200,
        "headers": {}
      },
      "meta": {
        "setVariables": {}
      }
    },
    {
      "description": "As teacher-A, try to get all students of any teacher with POST getCollection",
      "when": {
        "method": "POST",
        "uri": "/students/getCollection",
        "headers": {
          "content-type": [
            "application/json"
          ],
          "accept": [
            "application/json"
          ],
          "api-key": [
            "teacher-a-apikey"
          ]
        },
        "body": {}
      }
    },
    {
      "then": {
        "body": {},
        "status": 403,
        "headers": {}
      },
      "meta": {
        "setVariables": {}
      }
    },
    {
      "description": "As teacher-A, get all students of teacher-A with POST /getCollection",
      "when": {
        "method": "POST",
        "uri": "/students/getCollection",
        "headers": {
          "content-type": [
            "application/json"
          ],
          "accept": [
            "application/json"
          ],
          "api-key": [
            "teacher-a-apikey"
          ]
        },
        "body": {
          "filter": {
            "teacherId": {
              "eq": "teacher-A"
            }
          }
        }
      }
    },
    {
      "then": {
        "body": {
          "items": [
            {
              "teacherId": "teacher-A"
            },
            {
              "teacherId": "teacher-A"
            }
          ]
        },
        "status": 200,
        "headers": {}
      },
      "meta": {
        "setVariables": {}
      }
    },
    {
      "description": "As teacher-A, try to get all students of teacher-B (unauthorized)",
      "when": {
        "method": "GET",
        "uri": "/students?filter.teacherId.eq=teacher-B",
        "headers": {
          "accept": [
            "application/json"
          ],
          "api-key": [
            "teacher-a-apikey"
          ]
        }
      }
    },
    {
      "then": {
        "body": {
          "errors": [
            {
              "rejectedValue": "teacher-B",
              "field": "/request/query/filter.teacherId.eq/0"
            }
          ]
        },
        "status": 403,
        "headers": {}
      },
      "meta": {
        "setVariables": {}
      }
    },
    {
      "description": "As student student-s1, get info about myself",
      "when": {
        "method": "GET",
        "uri": "{{student-anna-href}}",
        "headers": {
          "accept": [
            "application/json"
          ],
          "api-key": [
            "student-anna-apikey"
          ]
        }
      }
    },
    {
      "then": {
        "body": {
          "studentId": "student-anna"
        },
        "status": 200,
        "headers": {}
      },
      "meta": {
        "setVariables": {}
      }
    },
    {
      "description": "As student student-s1, cannot get info about other student, not even info of that the student resource exists.",
      "when": {
        "method": "GET",
        "uri": "{{student-robert-href}}",
        "headers": {
          "accept": [
            "application/json"
          ],
          "api-key": [
            "student-anna-apikey"
          ]
        }
      }
    },
    {
      "then": {
        "status": 404,
        "headers": {}
      },
      "meta": {
        "setVariables": {}
      }
    },
    {
      "description": "As student student-s2 and get info about robert",
      "when": {
        "method": "GET",
        "uri": "{{student-robert-href}}",
        "headers": {
          "accept": [
            "application/json"
          ],
          "api-key": [
            "student-robert-apikey"
          ]
        }
      }
    },
    {
      "then": {
        "status": 200,
        "headers": {}
      },
      "meta": {
        "setVariables": {}
      }
    },
    {
      "description": "As student student-s3 (robert), update email of  robert",
      "when": {
        "method": "PATCH",
        "uri": "{{student-robert-href}}",
        "headers": {
          "content-type": [
            "application/json"
          ],
          "accept": [
            "application/json"
          ],
          "api-key": [
            "student-robert-apikey"
          ]
        },
        "body": {
          "email": "rob@example.com"
        }
      }
    },
    {
      "then": {
        "status": 200,
        "headers": {},
        "body": {
          "email": "rob@example.com",
          "studentId": "student-robert"
        }
      },
      "meta": {
        "setVariables": {}
      }
    },
    {
      "description": "As student student-s1 (anna), failing to update email of  robert",
      "when": {
        "method": "PATCH",
        "uri": "{{student-robert-href}}",
        "headers": {
          "content-type": [
            "application/json"
          ],
          "accept": [
            "application/json"
          ],
          "api-key": [
            "student-anna-apikey"
          ]
        },
        "body": {
          "email": "rob@example.com"
        }
      }
    },
    {
      "then": {
        "status": 404,
        "headers": {},
        "body": {}
      },
      "meta": {
        "setVariables": {}
      }
    },
    {
      "description": "As admin, cannot set grade to other than F when attendancePercent is less than 50",
      "when": {
        "method": "PATCH",
        "uri": "{{student-peter-href}}",
        "headers": {
          "content-type": [
            "application/json"
          ],
          "accept": [
            "application/json"
          ],
          "api-key": [
            "admin-a1-apikey"
          ]
        },
        "body": {
          "attendancePercent": 30
        }
      }
    },
    {
      "then": {
        "status": 409,
        "headers": {},
        "body": {}
      },
      "meta": {
        "setVariables": {}
      }
    },
    {
      "description": "As admin , get all students",
      "when": {
        "method": "GET",
        "uri": "/students",
        "headers": {
          "accept": [
            "application/json"
          ],
          "api-key": [
            "admin-a1-apikey"
          ]
        }
      }
    },
    {
      "then": {
        "body": {
          "items": [
            {
              "teacherId": "teacher-A"
            },
            {
              "teacherId": "teacher-A"
            },
            {
              "teacherId": "teacher-A"
            }
          ]
        },
        "status": 200,
        "headers": {}
      },
      "meta": {
        "setVariables": {}
      }
    },
    {
      "description": "As admin, delete student robert",
      "when": {
        "method": "DELETE",
        "uri": "{{student-robert-href}}",
        "headers": {
          "accept": [
            "application/json"
          ],
          "api-key": [
            "admin-a1-apikey"
          ]
        }
      }
    },
    {
      "then": {
        "status": 204,
        "headers": {}
      },
      "meta": {
        "setVariables": {}
      }
    },
    {
      "description": "As admin, try to get deleted student robert",
      "when": {
        "method": "GET",
        "uri": "{{student-robert-href}}",
        "headers": {
          "accept": [
            "application/json"
          ],
          "api-key": [
            "admin-a1-apikey"
          ]
        }
      }
    },
    {
      "then": {
        "status": 404,
        "headers": {}
      },
      "meta": {
        "setVariables": {}
      }
    },
    {
      "description": "As admin, get all with special ids (in=abc123,def456) failing",
      "when": {
        "method": "GET",
        "uri": "/students?filter.meta.id.in=abc123,def456",
        "headers": {
          "accept": [
            "application/json"
          ],
          "api-key": [
            "admin-a1-apikey"
          ]
        }
      }
    },
    {
      "then": {
        "status": 400,
        "headers": {}
      },
      "meta": {
        "setVariables": {}
      }
    },
    {
      "description": "As Peter, delete student Anna",
      "when": {
        "method": "DELETE",
        "uri": "{{student-anna-href}}",
        "headers": {
          "accept": [
            "application/json"
          ],
          "api-key": [
            "student-peter-apikey"
          ]
        }
      }
    },
    {
      "then": {
        "status": 404,
        "headers": {}
      },
      "meta": {
        "setVariables": {}
      }
    },
    {
      "description": "As Admin, delete non-existing student",
      "when": {
        "method": "DELETE",
        "uri": "/students/nonexisting-1234567890",
        "headers": {
          "accept": [
            "application/json"
          ],
          "api-key": [
            "admin-a1-apikey"
          ]
        }
      }
    },{
      "then": {
        "status": 404,
        "headers": {}
      },
      "meta": {
        "setVariables": {}
      }
    }
  ]
}
