{
  "meta": {
    "validationStrategy": "JSON_SCHEMA",
    "variables": {
      "##players": "players"
    }
  },
  "tests": [
    {
      "given": {
        "dbSetup": {
          "connection": "mongodb://admin:adminpassword@localhost:27017/?authSource=admin",
          "db": "dcentb-mytest",
          "commands": [
            {
              "drop": {
                "collection": "##players"
              }
            }
          ]
        },
        "config": {
          "openapi": "3.1.0",
          "accessControl": {
            "userInfo": {
            }
          },
          "paths": {
            "/players": {
              "post": {
                "requestBody": {
                  "required": true,
                  "content": {
                    "application/json": {
                      "schema": {
                        "type": "object",
                        "properties": {
                          "name": {
                            "type": "string"
                          },
                          "age": {
                            "type": "integer"
                          }
                        }
                      }
                    }
                  }
                },
                "x-dcentb": {
                  "mongodb": {
                    "collection": "players",
                    "connection": "mongodb://admin:adminpassword@localhost:27017/?authSource=admin",
                    "db": "dcentb-mytest"
                  },
                  "accessControl": {
                    "permissionSchemas": [
                      {
                        "permission": "AUTHENTICATED_DEFAULT",
                        "requestSchema": {},
                        "responseSchema": true
                      }
                    ]
                  }
                }
              },
              "get": {
                "parameters": [
                  {
                    "in": "query",
                    "name": "filter.name.eq",
                    "schema": {
                      "type": "string"
                    },
                    "required": false
                  },
                  {
                    "in": "query",
                    "name": "limit",
                    "schema": {
                      "type": "integer"
                    },
                    "required": false
                  },
                  {
                    "in": "query",
                    "name": "offset",
                    "schema": {
                      "type": "integer"
                    },
                    "required": false
                  },
                  {
                    "in": "query",
                    "name": "orderBy",
                    "schema": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "required": false
                  }
                ],
                "x-dcentb": {
                  "mongodb": {
                    "collection": "players",
                    "connection": "mongodb://admin:adminpassword@localhost:27017/?authSource=admin",
                    "db": "dcentb-mytest"
                  },
                  "accessControl": {
                    "permissionSchemas": [
                      {
                        "permission": "productA",
                        "requestSchema": {
                          "properties": {
                            "request": {
                              "properties": {
                                "body": {
                                  "properties": {
                                    "customerIdOfOrder": {
                                      "const": {
                                        "$data": "/userInfo/customerIdOfUser"
                                      },
                                      "equals": [
                                        "/userInfo/customerIdOfUser"
                                      ]
                                    }
                                  }
                                }
                              }
                            }
                          }
                        }
                      },
                      {
                        "permission": "AUTHENTICATED_DEFAULT",
                        "requestSchema": {
                          "properties": {
                            "request": {
                              "properties": {
                                "body": {
                                  "properties": {
                                    "name": false
                                  }
                                }
                              }
                            }
                          }
                        },
                        "responseSchema": {
                          "properties": {
                            "response": {
                              "properties": {
                                "body": {
                                  "properties": {
                                    "items": {
                                      "type": "array",
                                      "items": {
                                        "type": "object",
                                        "properties": {
                                          "name": {
                                            "enum": [
                                              "Peter"
                                            ]
                                          }
                                        }
                                      }
                                    }
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "when": {
        "method": "POST",
        "uri": "/players",
        "headers": {
          "content-type": [
            "application/json"
          ]
        },
        "body": "{\"name\": \"Alice\", \"age\": 30}"
      }
    },
    {
      "then": {
        "type": "object",
        "properties": {
          "status": {
            "const": 201
          },
          "headers": {
            "type": "object",
            "properties": {
              "location": {
                "type": "string",
                "pattern": "^/players/[a-f0-9]{32}$"
              }
            },
            "required": [
              "location"
            ]
          },
          "body": {
            "type": "object",
            "properties": {
              "meta": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{32}$"
                  }
                },
                "required": [
                  "id"
                ]
              },
              "name": {
                "const": "Alice"
              },
              "age": {
                "const": 30
              }
            },
            "required": [
              "meta",
              "name",
              "age"
            ]
          }
        },
        "required": [
          "status",
          "headers",
          "body"
        ]
      }
    },
    {
      "when": {
        "method": "GET",
        "uri": "/players"
      }
    },
    {
      "then": {
        "properties": {
          "status": {
            "const": 200
          }
        }
      }
    },
    {
      "when": {
        "method": "GET",
        "uri": "/not-part-of-the-api"
      }
    },
    {
      "then": {
        "properties": {
          "status": {
            "const": 404
          }
        }
      }
    },
    {
      "when": {
        "method": "PATCH",
        "uri": "/players"
      }
    },
    {
      "then": {
        "properties": {
          "status": {
            "const": 405
          }
        }
      },
      "meta": {
        "validationStrategy": "JSON_SCHEMA",
        "variables": {
          "id" : "$/status"
        }
      }
    }
  ]
}
