{
  "x-dcentb": {
    "mongodb": {
      "db": "dcentb-demo"
    },
    "users": {
      "user-s1": {
        "studentId": "student-anna"
      },
      "user-s2": {
        "studentId": "student-peter"
      },
      "user-s3": {
        "studentId": "student-robert"
      },
      "user-t1": {
        "teacherId": "teacher-A"
      },
      "user-t2": {
        "teacherId": "teacher-B"
      },
      "user-a1": {
      }
    },
    "accessControl": {
      "apiKeys": {
        "<random-secret>_<user-id>_<roles>": {},
        "ak-demo-87162534_user-s1_student": {},
        "ak-demo-18783325_user-s2_student": {},
        "ak-demo-18783325_user-s3_student": {},
        "ak-demo-84441136_user-t1_teacher": {},
        "ak-demo-35365462_user-t2_teacher": {},
        "ak-demo-42288333_user-a1_admin": {}
      }
    },
    "collections": {
      "students": {
        "permissions": {
          "student": {
            "readCollection": {
              "properties": {
                "description": "This is the 'items' property of the collection that is of type array (which is described by a keyword that is also called 'items' which contains the schema for every item in the array)",
                "items": {
                  "type": "array",
                  "items": {
                  }
                }
              }
            },
            "readItem": {
              "required": ["studentId"],
              "properties": {
                "studentId": {
                  "const": {
                    "$data": "/authenticatedUser/studentId"
                  }
                }
              }
            },
            "writeItem": {
              "properties": {
                "studentId": {
                  "const": {
                    "$data": "#/authenticatedUser/studentId"
                  }
                }
              }
            }
          },
          "admin": {
            "readCollection": {},
            "readItem": {},
            "writeItem": {}
          },
          "teacher": {
            "readCollection": {
              "properties": {
                "items": {
                  "type": "array",
                  "items": {
                    "$ref": "#/x-dcentb/collections/students/permissions/teacher/readItem"
                  }
                }
              }
            },
            "readItem": {
              "required": [
                "teacherId"
              ],
              "properties": {
                "teacherId": {
                  "const": {
                    "$data": "#/authenticatedUser/teacherId"
                  }
                }
              }
            },
            "writeItem": {}
          }
        },
        "stateTransitionSchema": {
          "if": {
            "required": [
              "currentState"
            ],
            "properties": {
              "currentState": {
                "type": "object"
              }
            }
          },
          "then": {
            "properties": {
              "newState": {
                "properties": {
                  "studentId": {
                    "const": {
                      "$data": "/currentState/studentId"
                    }
                  }
                }
              }
            }
          },
          "properties": {
            "newState": {
              "anyOf": [
                {
                  "properties": {
                    "grade": {
                      "enum": [
                        "A",
                        "B",
                        "C",
                        "D",
                        "E"
                      ]
                    },
                    "attendancePercent": {
                      "minimum": 50
                    }
                  }
                },
                {
                  "properties": {
                    "grade": {
                      "enum": [
                        "F"
                      ]
                    },
                    "attendancePercent": {
                      "minimum": 0
                    }
                  }
                }
              ]
            }
          }
        }
      }
    }
  },
  "openapi": "3.1.0",
  "security": [
    {
      "ApiKeyAuth": []
    }
  ],
  "paths": {
    "/students": {
      "post": {
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Students_item_v1",
                "allOf": [
                  {
                    "properties": {
                      "name": true,
                      "email": true,
                      "studentId": true,
                      "teacherId": true,
                      "grade": true,
                      "attendancePercent": true
                    },
                    "additionalProperties": false
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Students_item_v1"
                }
              }
            }
          }
        },
        "x-dcentb": {
          "mongodb": {
            "comment": "The 'collection' is omitted to test that the default behavior of finding collection name based on path is working"
          },
          "accessControl": {
            "permissionSchemas": {
              "admin": {
                "requestSchema": {
                  "properties": {
                    "request": {
                      "properties": {
                        "body": {
                          "$ref": "#/x-dcentb/collections/students/permissions/admin/writeItem"
                        }
                      }
                    }
                  }
                },
                "responseSchema": {
                  "response": {
                    "properties": {
                      "body": {
                        "$ref": "#/x-dcentb/collections/students/permissions/admin/readItem"
                      }
                    }
                  }
                }
              }
            }
          },
          "stateTransitionSchema": {
            "$ref": "#/x-dcentb/collections/students/stateTransitionSchema"
          }
        }
      },
      "get": {
        "parameters": [
          {
            "in": "query",
            "name": "filter.name.eq",
            "schema": {
              "type": "string"
            },
            "required": false
          },
          {
            "in": "query",
            "name": "filter.teacherId.eq",
            "schema": {
              "type": "string"
            },
            "required": false
          },
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "type": "integer"
            },
            "required": false
          },
          {
            "in": "query",
            "name": "offset",
            "schema": {
              "type": "integer"
            },
            "required": false
          },
          {
            "in": "query",
            "name": "orderBy",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "name",
                  "name desc",
                  "meta.createdAt",
                  "meta.createdAt desc"
                ]
              }
            },
            "required": false
          }
        ],
        "x-dcentb": {
          "accessControl": {
            "permissionSchemas": {
              "admin": {
                "requestSchema": {},
                "responseSchema": {
                  "properties": {
                    "response": {
                      "properties": {
                        "body": {
                          "$ref": "#/x-dcentb/collections/students/permissions/admin/readCollection"
                        }
                      }
                    }
                  }
                }
              },
              "teacher": {
                "requestSchema": {
                  "properties": {
                    "request": {
                      "required": [
                        "query"
                      ],
                      "properties": {
                        "query": {
                          "required": [
                            "filter.teacherId.eq"
                          ],
                          "properties": {
                            "filter.teacherId.eq": {
                              "items": {
                                "const": {
                                  "$data": "/authenticatedUser/teacherId"
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                },
                "responseSchema": {
                  "properties": {
                    "response": {
                      "properties": {
                        "body": {
                          "$ref": "#/x-dcentb/collections/students/permissions/teacher/readCollection"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/students/{id}": {
      "delete": {
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No content"
          }
        },
        "x-dcentb": {
          "accessControl": {
            "permissionSchemas": {
              "admin": {
                "requestSchema": {
                  "properties": {
                    "request": true
                  }
                },
                "responseSchema": {
                }
              },
              "student": {
                "requestSchema": {
                  "properties": {
                    "currentState": {
                      "properties": {
                        "studentId": {
                          "const": {
                            "$data": "/authenticatedUser/studentId"
                          }
                        }
                      }
                    }
                  }
                },
                "responseSchema": {
                }
              }
            }
          },
          "stateTransitionSchema": {
            "$ref": "#/x-dcentb/collections/students/stateTransitionSchema"
          }
        }
      },
      "get": {
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Students_item_v1"
                }
              }
            }
          }
        },
        "x-dcentb": {
          "accessControl": {
            "permissionSchemas": {
              "admin": {
                "requestSchema": {
                },
                "responseSchema": {
                  "properties": {
                    "response": {
                      "properties": {
                        "body": {
                          "$ref": "#/x-dcentb/collections/students/permissions/admin/readItem"
                        }
                      }
                    }
                  }
                }
              },
              "student": {
                "requestSchema": {
                  "properties": {
                    "request": true
                  }
                },
                "responseSchema": {
                  "properties": {
                    "response": {
                      "properties": {
                        "body": {
                          "required": [
                            "studentId"
                          ],
                          "properties": {
                            "studentId": {
                              "const": {
                                "$data": "/authenticatedUser/studentId"
                              }
                            },
                            "name": true,
                            "meta": true,
                            "grade": true,
                            "teacherId": true,
                            "email": true,
                            "attendancePercent": true
                          },
                          "additionalProperties": false
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "patch": {
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Students_item_v1",
                "allOf": [
                  {
                    "properties": {
                      "name": true,
                      "email": true,
                      "teacherId": true,
                      "grade": true,
                      "attendancePercent": true
                    },
                    "additionalProperties": false
                  }
                ]
              }
            }
          }
        },
        "x-dcentb": {
          "accessControl": {
            "permissionSchemas": {
              "student": {
                "requestSchema": {
                  "properties": {
                    "currentState": {
                      "$ref": "#/x-dcentb/collections/students/permissions/student/writeItem",
                      "required": [
                        "studentId"
                      ]
                    },
                    "request": {
                      "properties": {
                        "body": {
                          "$ref": "#/x-dcentb/collections/students/permissions/student/writeItem"
                        }
                      }
                    }
                  }
                },
                "responseSchema": {}
              },
              "admin": {
                "requestSchema": {},
                "responseSchema": {}
              }
            }
          },
          "stateTransitionSchema": {
            "$ref": "#/x-dcentb/collections/students/stateTransitionSchema"
          }
        }
      }
    },
    "/students/getCollection": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "offset": {
                    "type": "integer"
                  },
                  "limit": {
                    "type": "integer"
                  },
                  "filter": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "object",
                        "properties": {
                          "eq": {
                            "type": "string"
                          }
                        },
                        "additionalProperties": false
                      },
                      "teacherId": {
                        "type": "object",
                        "properties": {
                          "eq": {
                            "type": "string"
                          }
                        },
                        "additionalProperties": false
                      }
                    },
                    "additionalProperties": false
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        },
        "x-dcentb": {
          "accessControl": {
            "permissionSchemas": {
              "teacher": {
                "requestSchema": {
                  "properties": {
                    "request": {
                      "properties": {
                        "body": {
                          "required": [
                            "filter"
                          ],
                          "properties": {
                            "filter": {
                              "required": [
                                "teacherId"
                              ],
                              "properties": {
                                "teacherId": {
                                  "properties": {
                                    "eq": {
                                      "const": {
                                        "$data": "#/authenticatedUser/teacherId"
                                      }
                                    }
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                },
                "responseSchema": {
                  "properties": {
                    "response": {
                      "properties": {
                        "body": {
                          "$ref": "#/x-dcentb/collections/students/permissions/teacher/readCollection"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "api-key"
      }
    },
    "schemas": {
      "Meta_item_v1": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "href": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {}
        }
      },
      "Students_item_v1": {
        "type": "object",
        "properties": {
          "studentId": {
            "type": "string"
          },
          "teacherId": {
            "type": "string"
          },
          "meta": {
            "$ref": "#/components/schemas/Meta_item_v1"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "grade": {
            "enum": [
              "A",
              "B",
              "C",
              "D",
              "E",
              "F"
            ]
          },
          "attendancePercent": {
            "type": "integer"
          }
        }
      }
    }
  }
}